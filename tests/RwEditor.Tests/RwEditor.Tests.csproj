<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>RwEditor.Tests</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\RwEditor.Core\RwEditor.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="Golden\**\*" CopyToOutputDirectory="PreserveNewest" />
    <!-- the dictionary source, so the consistency tests can mutate a copy of it -->
    <None Include="..\..\data\stat-dictionary.json" Link="stat-dictionary.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
